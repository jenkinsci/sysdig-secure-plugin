<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:t="/lib/hudson">
    <t:summary icon="/plugin/sysdig-secure/images/sysdig-shovel.png">
        <a href="${it.urlName}" title="${it.scannedPath}">${it.displayName}</a>
        <j:choose>
            <j:when test="${it.hasFindings}">
                &#160;&#8212;&#160;${it.totalFindings} failed control(s)
                (high=${it.highFindings}, medium=${it.mediumFindings}, low=${it.lowFindings})
                across ${it.resourceViolations} resource violation(s)
            </j:when>
            <j:otherwise>
                &#160;&#8212;&#160;no findings
            </j:otherwise>
        </j:choose>
    </t:summary>
</j:jelly>
